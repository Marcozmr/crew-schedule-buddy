# Opcional: identificador de build no cliente (sobrescreve SHA automático em CI).
# Na Vercel, VERCEL_GIT_COMMIT_SHA / VERCEL_DEPLOYMENT_ID já alimentam o build id.
# VITE_ESCALAX_BUILD_ID=

# Sentry (frontend) — opcional. Sem VITE_SENTRY_DSN o SDK não inicializa (desenvolvimento local seguro).
# DSN: Project Settings → Client Keys (DSN). Não commite segredos; use variáveis no host (Vercel, etc.).
# VITE_SENTRY_DSN=
# Nome do ambiente no Sentry (default: import.meta.env.MODE).
# VITE_SENTRY_ENVIRONMENT=production
# Amostragem 0–1. Defaults: tracing 0, replay de sessão 0, replay em erro 1 (só têm efeito com DSN).
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1

# Rate limit de auth (Edge Function `auth-rate-limit` + Postgres). Requer função deployada e migration aplicada.
# VITE_AUTH_RATE_LIMIT_ENABLED=true
# Em falha de rede/5xx no check, permitir auth mesmo assim (default recomendado para disponibilidade).
# VITE_AUTH_RATE_LIMIT_FAIL_OPEN=true

# Auditoria de auth (RPC `log_auth_audit_event` + tabela `auth_audit_events`). Requer migration aplicada.
# `false` desativa persistência no Postgres; consola em DEV mantém-se.
# VITE_AUTH_AUDIT_PERSIST_ENABLED=true

# Indicador de system health (canto inferior direito). Em produção só com true; em DEV mostra sempre.
# VITE_SYSTEM_HEALTH_INDICATOR=true

# URL pública do app (origem, sem barra final). OBRIGATÓRIA no deploy de produção (Vercel).
# Usada em signUp / resend / resetPasswordForEmail (emailRedirectTo e redirectTo).
# Desenvolvimento local: deixe vazio — o app usa http://localhost:5173 (ou a porta do Vite).
# Produção: https://www.escalax.app.br
# VITE_APP_URL=https://www.escalax.app.br

# Supabase — EscalaX (project ref: fbryqzwykdhnmskfectg — deve coincidir com o hostname *.supabase.co)
# Copie para .env.local e preencha com os valores do Dashboard do projeto
# Dashboard → Authentication → URL Configuration:
#   Site URL: https://www.escalax.app.br
#   Redirect URLs (adicione todas):
#     https://www.escalax.app.br/**
#     https://escalax.app.br/**
#     http://localhost:5173/**
#     http://127.0.0.1:5173/**
VITE_SUPABASE_URL=https://fbryqzwykdhnmskfectg.supabase.co
# Chave anon/public (Dashboard → Settings → API). Qualquer um dos nomes abaixo:
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# APIs de voo — EscalaX Flight Board
# Frontend usa apenas Supabase URL/anon key.
# Segredos de APIs externas DEVEM ficar no backend (Supabase secrets):
#   OPENSKY_CLIENT_ID
#   OPENSKY_CLIENT_SECRET
#   OPENSKY_BASE_URL (opcional)
#
# Exemplo:
# supabase secrets set OPENSKY_CLIENT_ID=... OPENSKY_CLIENT_SECRET=...

# ---------------------------------------------------------------------------
# Edge Function send-support-email (somente Resend — sem SMTP)
# ---------------------------------------------------------------------------
# Segredos no Supabase (Dashboard → Edge Functions → Secrets), NÃO no Vite:
#
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx
#   supabase secrets set SUPPORT_TO_EMAIL=support@escalax.app.br
#   supabase secrets set RESEND_FROM="EscalaX <support@escalax.app.br>"
#
# RESEND_API_KEY — obrigatório para envio (chave em https://resend.com/api-keys )
# SUPPORT_TO_EMAIL — caixa que recebe os tickets (opcional; default no código)
# RESEND_FROM — remetente; o domínio do e-mail DEVE estar verificado em
#               https://resend.com/domains (senão a API falha com saved_email_failed).
#               Testes: use onboarding@resend.dev como RESEND_FROM.

# Forçar mock (ignorar APIs reais)
# VITE_FLIGHT_USE_MOCK=true

# ---------------------------------------------------------------------------
# Portal corporativo LATAM → EscalaX
# ---------------------------------------------------------------------------
# Fluxo: usuário autentica no portal; retorno via callback dinâmico:
#   ${origem}/auth/corporate-callback
# ou confirmação manual no app se o portal não redirecionar.
VITE_CORPORATE_PORTAL_ENABLED=true

# Ponto de entrada do portal (login corporativo LATAM).
VITE_CORPORATE_PORTAL_LOGIN_URL=https://portal.latam.com/

# Opcional: sobrescreve a URL de callback. Se vazio, usa origem atual + /auth/corporate-callback.
VITE_CORPORATE_PORTAL_RETURN_URL=

# Se true, anexa redirect_uri à URL de login (OAuth). Muitos portais corporativos não suportam —
# nesse caso use false e confirme o login manualmente no EscalaX.
VITE_CORPORATE_PORTAL_APPEND_REDIRECT_URI=false

# Serviço dedicado de automação (Node + Playwright), separado do frontend e das Edge Functions.
# Ex.: http://127.0.0.1:8790 — requer o mesmo projeto Supabase e variáveis no processo do worker.
# VITE_ROSTER_AUTOMATION_URL=
#
# Worker (processo em services/roster-automation): origens extra permitidas no CORS, além de localhost Vite/preview.
# Várias URLs separadas por vírgula, sem espaços ou com espaços após a vírgula (são ignorados).
# ROSTER_AUTOMATION_CORS_ORIGINS=https://app.seudominio.com,https://staging.seudominio.com

# ---------------------------------------------------------------------------
# iFlight (módulo operacional — integração futura de roster)
# ---------------------------------------------------------------------------
VITE_IFLIGHT_PROVIDER_ENABLED=true

# URL para abrir o módulo/referência iFlight no navegador (opcional).
# Ex.: página pública de produto ou URL interna fornecida pela empresa.
VITE_IFLIGHT_MODULE_URL=

# ---------------------------------------------------------------------------
# Roster sync (Google Calendar + Scheduler + Email)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
ROSTER_CHECK_CRON="0 3 * * *"
