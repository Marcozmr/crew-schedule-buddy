# Opcional: identificador de build no cliente (sobrescreve SHA automático em CI).
# Na Vercel, VERCEL_GIT_COMMIT_SHA / VERCEL_DEPLOYMENT_ID já alimentam o build id.
# VITE_ESCALAX_BUILD_ID=

# Supabase — EscalaX (project ref: fbryqzwykdhnmskfectg — deve coincidir com o hostname *.supabase.co)
# Copie para .env.local e preencha com os valores do Dashboard do projeto
VITE_SUPABASE_URL=https://fbryqzwykdhnmskfectg.supabase.co
# Chave anon/public (Dashboard → Settings → API). Qualquer um dos nomes abaixo:
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# APIs de voo — EscalaX Flight Board
# Frontend usa apenas Supabase URL/anon key.
# Segredos de APIs externas DEVEM ficar no backend (Supabase secrets):
#   OPENSKY_CLIENT_ID
#   OPENSKY_CLIENT_SECRET
#   OPENSKY_BASE_URL (opcional)
#
# Exemplo:
# supabase secrets set OPENSKY_CLIENT_ID=... OPENSKY_CLIENT_SECRET=...

# ---------------------------------------------------------------------------
# Edge Function send-support-email (somente Resend — sem SMTP)
# ---------------------------------------------------------------------------
# Segredos no Supabase (Dashboard → Edge Functions → Secrets), NÃO no Vite:
#
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx
#   supabase secrets set SUPPORT_TO_EMAIL=support@escalax.app.br
#   supabase secrets set RESEND_FROM="EscalaX <support@escalax.app.br>"
#
# RESEND_API_KEY — obrigatório para envio (chave em https://resend.com/api-keys )
# SUPPORT_TO_EMAIL — caixa que recebe os tickets (opcional; default no código)
# RESEND_FROM — remetente; o domínio do e-mail DEVE estar verificado em
#               https://resend.com/domains (senão a API falha com saved_email_failed).
#               Testes: use onboarding@resend.dev como RESEND_FROM.

# Forçar mock (ignorar APIs reais)
# VITE_FLIGHT_USE_MOCK=true

# ---------------------------------------------------------------------------
# Portal corporativo LATAM → EscalaX
# ---------------------------------------------------------------------------
# Fluxo: usuário autentica no portal; retorno via callback dinâmico:
#   ${origem}/auth/corporate-callback
# ou confirmação manual no app se o portal não redirecionar.
VITE_CORPORATE_PORTAL_ENABLED=true

# Ponto de entrada do portal (login corporativo LATAM).
VITE_CORPORATE_PORTAL_LOGIN_URL=https://portal.latam.com/

# Opcional: sobrescreve a URL de callback. Se vazio, usa origem atual + /auth/corporate-callback.
VITE_CORPORATE_PORTAL_RETURN_URL=

# Se true, anexa redirect_uri à URL de login (OAuth). Muitos portais corporativos não suportam —
# nesse caso use false e confirme o login manualmente no EscalaX.
VITE_CORPORATE_PORTAL_APPEND_REDIRECT_URI=false

# ---------------------------------------------------------------------------
# iFlight (módulo operacional — integração futura de roster)
# ---------------------------------------------------------------------------
VITE_IFLIGHT_PROVIDER_ENABLED=true

# URL para abrir o módulo/referência iFlight no navegador (opcional).
# Ex.: página pública de produto ou URL interna fornecida pela empresa.
VITE_IFLIGHT_MODULE_URL=
