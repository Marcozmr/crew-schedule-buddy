{
  "manifest_version": 3,
  "name": "EscalaX — Sessão iFlight",
  "version": "1.0.0",
  "description": "Autoriza a sincronização automática da sua escala LATAM/iFlight no EscalaX. Captura apenas cookies de portal.latam.com e iflightla.ibsplc.aero.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://portal.latam.com/*",
    "https://iflightla.ibsplc.aero/*",
    "https://www.escalax.app.br/*",
    "https://escalax-roster-worker.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "EscalaX — Sessão iFlight"
  },
  "content_scripts": [
    {
      "matches": ["https://www.escalax.app.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
